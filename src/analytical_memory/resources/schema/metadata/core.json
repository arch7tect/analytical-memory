{
  "compatibility": {
    "minimum_reader": "1"
  },
  "ingestion_batch": {
    "format": "jsonl",
    "format_version": "5",
    "idempotency": "entity_type_key_selector_content_hash",
    "semantics": "atomic_patch_upsert"
  },
  "json_types": ["unresolved", "string", "number", "boolean", "object", "array"],
  "ontology_version": "2.0.0",
  "privacy_classes": ["public", "private"],
  "record_types": [
    "Source",
    "AnalyticalRun",
    "Node",
    "NodeAttribute",
    "Relation",
    "Metric",
    "NamespaceDeclaration",
    "EntityDeclaration",
    "ObservedField",
    "OntologyDeclaration",
    "EvidenceObject",
    "EvidenceAcquisition",
    "EvidenceDerivation",
    "EvidenceLocation",
    "EvidenceFragment",
    "EvidenceVerification",
    "EvidenceRetirement",
    "SearchDocument",
    "EmbeddingProfile",
    "EmbeddingRecord",
    "IngestionBatch",
    "SchemaMigration"
  ],
  "relation": {
    "directions": ["outbound", "inbound", "both"],
    "properties_allowed": false
  },
  "schema_document_version": "8"
}
