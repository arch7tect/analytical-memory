{
  "contract_document_version": "1",
  "examples": [
    {
      "limit": 100,
      "match": {
        "edges": [],
        "nodes": [
          {
            "as": "session",
            "type": "example.Session"
          }
        ]
      },
      "offset": 0,
      "query_ir_version": "1",
      "return": [
        {
          "field": "session.status"
        }
      ],
      "where": [
        {
          "left": {
            "field": "session.status"
          },
          "op": "eq",
          "right": {
            "value": "failed"
          }
        }
      ]
    },
    {
      "match": {
        "edges": [],
        "nodes": [
          {
            "as": "session",
            "type": "example.Session"
          }
        ]
      },
      "query_ir_version": "1",
      "return": [
        {
          "count": true
        }
      ]
    }
  ],
  "input_schema": {
    "$defs": {
      "QueryComparisonPredicate": {
        "additionalProperties": false,
        "properties": {
          "left": {
            "$ref": "#/$defs/QueryFieldOperand",
            "description": "Attribute field to compare."
          },
          "op": {
            "description": "Typed comparison operator.",
            "enum": [
              "eq",
              "ne",
              "lt",
              "lte",
              "gt",
              "gte"
            ],
            "title": "Op",
            "type": "string"
          },
          "right": {
            "$ref": "#/$defs/QueryValueOperand",
            "description": "Single exact typed comparison value."
          }
        },
        "required": [
          "left",
          "op",
          "right"
        ],
        "title": "QueryComparisonPredicate",
        "type": "object"
      },
      "QueryCountProjection": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "const": true,
            "description": "Request a row count; cannot be mixed with field projections.",
            "title": "Count",
            "type": "boolean"
          }
        },
        "required": [
          "count"
        ],
        "title": "QueryCountProjection",
        "type": "object"
      },
      "QueryEdgePattern": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "description": "Source node alias; relation direction is source to target.",
            "minLength": 1,
            "title": "From",
            "type": "string"
          },
          "logical_key": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional exact relation logical-key filter.",
            "title": "Logical Key"
          },
          "to": {
            "description": "Target node alias for the directed relation.",
            "minLength": 1,
            "title": "To",
            "type": "string"
          },
          "type": {
            "description": "Exact active relation type from the selected ontology.",
            "minLength": 1,
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "from",
          "to"
        ],
        "title": "QueryEdgePattern",
        "type": "object"
      },
      "QueryExistsPredicate": {
        "additionalProperties": false,
        "properties": {
          "left": {
            "$ref": "#/$defs/QueryFieldOperand",
            "description": "Attribute whose row presence is tested."
          },
          "op": {
            "const": "exists",
            "description": "Presence operator; explicit null exists, missing does not.",
            "title": "Op",
            "type": "string"
          }
        },
        "required": [
          "left",
          "op"
        ],
        "title": "QueryExistsPredicate",
        "type": "object"
      },
      "QueryFieldOperand": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "description": "Field reference in '<node-alias>.<attribute-name>' form.",
            "minLength": 3,
            "title": "Field",
            "type": "string"
          }
        },
        "required": [
          "field"
        ],
        "title": "QueryFieldOperand",
        "type": "object"
      },
      "QueryFieldProjection": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "description": "Projected '<node-alias>.<attribute-name>' field with provenance.",
            "minLength": 3,
            "title": "Field",
            "type": "string"
          }
        },
        "required": [
          "field"
        ],
        "title": "QueryFieldProjection",
        "type": "object"
      },
      "QueryInPredicate": {
        "additionalProperties": false,
        "properties": {
          "left": {
            "$ref": "#/$defs/QueryFieldOperand",
            "description": "Attribute field to test for membership."
          },
          "op": {
            "const": "in",
            "description": "Membership operator; must be 'in'.",
            "title": "Op",
            "type": "string"
          },
          "right": {
            "$ref": "#/$defs/QueryValuesOperand",
            "description": "Accepted exact typed values."
          }
        },
        "required": [
          "left",
          "op",
          "right"
        ],
        "title": "QueryInPredicate",
        "type": "object"
      },
      "QueryMatch": {
        "additionalProperties": false,
        "properties": {
          "edges": {
            "description": "Directed active-relation patterns connecting node aliases.",
            "items": {
              "$ref": "#/$defs/QueryEdgePattern"
            },
            "maxItems": 8,
            "title": "Edges",
            "type": "array"
          },
          "nodes": {
            "description": "Connected node patterns participating in the query.",
            "items": {
              "$ref": "#/$defs/QueryNodePattern"
            },
            "maxItems": 8,
            "minItems": 1,
            "title": "Nodes",
            "type": "array"
          }
        },
        "required": [
          "nodes"
        ],
        "title": "QueryMatch",
        "type": "object"
      },
      "QueryNodePattern": {
        "additionalProperties": false,
        "properties": {
          "as": {
            "description": "Unique query-local alias used by edges and field references.",
            "minLength": 1,
            "title": "As",
            "type": "string"
          },
          "type": {
            "description": "Exact namespaced entity type from the selected ontology.",
            "minLength": 3,
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "as"
        ],
        "title": "QueryNodePattern",
        "type": "object"
      },
      "QueryOrderBy": {
        "additionalProperties": false,
        "properties": {
          "direction": {
            "default": "asc",
            "description": "Ascending or descending value order.",
            "enum": [
              "asc",
              "desc"
            ],
            "title": "Direction",
            "type": "string"
          },
          "field": {
            "description": "Ordering field in '<node-alias>.<attribute-name>' form.",
            "minLength": 3,
            "title": "Field",
            "type": "string"
          }
        },
        "required": [
          "field"
        ],
        "title": "QueryOrderBy",
        "type": "object"
      },
      "QueryValueOperand": {
        "additionalProperties": false,
        "properties": {
          "value": {
            "description": "Exact typed JSON literal; values are never implicitly coerced.",
            "title": "Value"
          }
        },
        "required": [
          "value"
        ],
        "title": "QueryValueOperand",
        "type": "object"
      },
      "QueryValuesOperand": {
        "additionalProperties": false,
        "properties": {
          "values": {
            "description": "Non-empty exact typed JSON literals for the in operator.",
            "items": {},
            "minItems": 1,
            "title": "Values",
            "type": "array"
          }
        },
        "required": [
          "values"
        ],
        "title": "QueryValuesOperand",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "limit": {
        "default": 100,
        "description": "Maximum result rows before truncation reporting.",
        "maximum": 1000,
        "minimum": 1,
        "title": "Limit",
        "type": "integer"
      },
      "match": {
        "$ref": "#/$defs/QueryMatch",
        "description": "Connected node and directed-edge pattern."
      },
      "offset": {
        "default": 0,
        "description": "Zero-based result-row offset.",
        "minimum": 0,
        "title": "Offset",
        "type": "integer"
      },
      "order_by": {
        "description": "Explicit ordering fields before deterministic Node-ID tie-breakers.",
        "items": {
          "$ref": "#/$defs/QueryOrderBy"
        },
        "title": "Order By",
        "type": "array"
      },
      "query_ir_version": {
        "const": "1",
        "description": "Query language version; V1 requires the string '1'.",
        "title": "Query Ir Version",
        "type": "string"
      },
      "return": {
        "description": "Field projections or one count projection.",
        "items": {
          "anyOf": [
            {
              "$ref": "#/$defs/QueryFieldProjection"
            },
            {
              "$ref": "#/$defs/QueryCountProjection"
            }
          ]
        },
        "minItems": 1,
        "title": "Return",
        "type": "array"
      },
      "where": {
        "description": "Predicates combined by implicit AND; OR is not supported.",
        "items": {
          "anyOf": [
            {
              "$ref": "#/$defs/QueryComparisonPredicate"
            },
            {
              "$ref": "#/$defs/QueryInPredicate"
            },
            {
              "$ref": "#/$defs/QueryExistsPredicate"
            }
          ]
        },
        "title": "Where",
        "type": "array"
      }
    },
    "required": [
      "query_ir_version",
      "match",
      "return"
    ],
    "title": "QueryIRDocument",
    "type": "object"
  },
  "query_ir_version": "1",
  "result_schema": {
    "$defs": {
      "QueryEffectiveOrdering": {
        "additionalProperties": false,
        "properties": {
          "direction": {
            "description": "Direction applied by traversal or ordering.",
            "enum": [
              "asc",
              "desc"
            ],
            "title": "Direction",
            "type": "string"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Field expression or attribute name used by this result item.",
            "title": "Field"
          },
          "tie_breaker": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Deterministic secondary ordering used for equal values.",
            "title": "Tie Breaker"
          }
        },
        "required": [
          "direction"
        ],
        "title": "QueryEffectiveOrdering",
        "type": "object"
      },
      "QueryProjectionResult": {
        "additionalProperties": false,
        "properties": {
          "batch_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Canonical identifier of the ingestion or mutation batch.",
            "title": "Batch Id"
          },
          "field": {
            "description": "Field expression or attribute name used by this result item.",
            "title": "Field",
            "type": "string"
          },
          "fragment_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
