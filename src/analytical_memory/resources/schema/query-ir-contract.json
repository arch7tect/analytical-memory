    "title": "QueryIRResponse",
    "type": "object"
  },
  "schema_fingerprint": "3176355e7b7637b312c768bef5a11f299d2cb144cff8645dc0d5c306eb099b39",
  "semantics": {
    "bindings": "every non-count row maps each node alias to its Node ID",
    "comparison": "literals must match the field effective JSON type; strings and numbers are never coerced",
    "count": "count cannot be combined with field projections",
    "disconnected_patterns": "multi-node patterns must form one connected component",
    "edges": "directed active relations only",
    "exists": "tests attribute-row presence, so explicit null exists",
    "field_reference": "<node-alias>.<attribute-name>",
    "missing": "no current NodeAttribute row",
    "missing_projection": "a missing projected attribute has null value and null record_id; record_id distinguishes it from an explicit null value",
    "not_equal": "ne matches only present attributes of the effective field type; missing attributes do not match",
    "null": "a present NodeAttribute whose JSON value is null",
    "ordering": "explicit fields first, present values before missing values, then every node alias ID ascending as a deterministic tie-breaker",
    "pagination": "limit defaults to 100, offset defaults to 0; truncated uses a limit-plus-one probe",
    "provenance": "each field projection includes its current record, source, batch, run, evidence fragment, and update time",
    "string_ordering": "Unicode casefold, then original code-point order",
    "unresolved": "typed comparison produces no matches",
    "where": "implicit conjunction; OR is not supported"
  }
}
