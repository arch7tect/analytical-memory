            "title": "Json Type",
            "type": "string"
          },
          "node_id": {
            "description": "Canonical identifier of the Node owning this value.",
            "title": "Node Id",
            "type": "string"
          },
          "record_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
