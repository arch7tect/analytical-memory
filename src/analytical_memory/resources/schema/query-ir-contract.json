        "required": [
          "batch_id",
          "field",
          "fragment_id",
          "json_type",
          "node_id",
          "record_id",
          "run_id",
          "source_id",
          "updated_at",
          "value"
        ],
        "title": "QueryProjectionResult",
        "type": "object"
      },
      "QueryRow": {
        "additionalProperties": false,
        "properties": {
          "bindings": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Mapping from query aliases to canonical Node IDs.",
            "title": "Bindings",
            "type": "object"
          },
          "projections": {
            "description": "Requested projected values with direct provenance.",
            "items": {
              "$ref": "#/$defs/QueryProjectionResult"
            },
            "title": "Projections",
            "type": "array"
          }
        },
        "required": [
          "bindings",
          "projections"
        ],
        "title": "QueryRow",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "contract_fingerprint": {
        "description": "Structural contract fingerprint used by the operation.",
        "title": "Contract Fingerprint",
        "type": "string"
      },
      "count": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Aggregate row count for a count query; absent for row queries.",
        "title": "Count"
      },
      "ontology_fingerprint": {
        "description": "Fingerprint of the selected memory's current ontology.",
        "title": "Ontology Fingerprint",
        "type": "string"
      },
      "ordering": {
        "description": "Effective deterministic ordering applied to query rows.",
        "items": {
          "$ref": "#/$defs/QueryEffectiveOrdering"
        },
        "title": "Ordering",
        "type": "array"
      },
      "rows": {
        "description": "Ordered Query IR rows; absent for count queries.",
        "items": {
          "$ref": "#/$defs/QueryRow"
        },
        "title": "Rows",
        "type": "array"
      },
      "truncated": {
        "description": "Whether a configured result bound omitted additional items.",
        "title": "Truncated",
        "type": "boolean"
      }
    },
    "required": [
      "contract_fingerprint",
      "ontology_fingerprint",
      "ordering",
      "rows",
      "truncated"
